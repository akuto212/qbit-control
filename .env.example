# Copy to .env on the server. Keep .env private; never commit it.
QBIT_URL=http://qbittorrent:8080
# Generate in qBittorrent 5.2.3: Settings -> Web UI -> API Key.
# Replace with the real 32-character key. This placeholder intentionally fails validation.
QBIT_API_KEY=replace_with_your_qbt_api_key

# Public hostname, without scheme, path or trailing slash.
QBT_CONTROL_HOST=qbt-control.example.com

# Existing Docker networks (actual names, including a Compose prefix if present).
TRAEFIK_NETWORK=traefik
QBIT_NETWORK=qbit-internal

# Reuse the existing names from your Traefik setup.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
TRAEFIK_MIDDLEWARES=tinyauth@docker,security-headers@file
